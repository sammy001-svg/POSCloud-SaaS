# Disable directory browsing
Options -Indexes

# Security: Protect hidden files and directories
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect to HTTPS (Always recommended for SaaS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Front Controller Pattern
    # Ensure physical files and directories are served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Prevent access to specific sensitive directories
    RewriteRule ^(config|database|cron|scratch)/ - [F,L]
    RewriteRule ^\.git/ - [F,L]
</IfModule>

# PHP Performance & Security Tweaks for cPanel
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value session.gc_maxlifetime 28800
    php_flag display_errors Off
</IfModule>
